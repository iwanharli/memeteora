<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.memet.ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/iwanharli/Harlixuan/PROJECT/PY/memet/scripts/run_ingest.sh</string>
    </array>

    <!-- wall-clock aligned, so windows line up across days -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/iwanharli/Harlixuan/PROJECT/PY/memet</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MEMET_DSN</key>
        <string>dbname=db_memet</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/iwanharli/Harlixuan/PROJECT/PY/memet/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/iwanharli/Harlixuan/PROJECT/PY/memet/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
