# Python ingest
MEMET_DSN=dbname=db_memet

# Fee sync (exec/, TypeScript). Reads public DLMM accounts only; never signs.
# The public RPC works but rate-limits, which is what keeps FEE_SYNC_SECONDS
# from going much below 600 without a paid endpoint.
SOLANA_RPC=
FEE_SYNC_SECONDS=600

# Rust web (sqlx wants a URL, not a keyword DSN)
DATABASE_URL=postgres:///db_memet
BIND_ADDR=127.0.0.1:8080

# --- reading the VPS database from a local machine -------------------------
# The worker runs on the VPS and owns the write side; a second scheduler would
# double-write every snapshot, so locally only the web app points here.
#
#   make tunnel       open the ssh forward (localhost:15432 -> VPS 5432)
#   make web-remote   run the web app against it
#   make tunnel-down  close it
#
# sslmode=disable is correct here: the ssh tunnel already encrypts the hop, and
# from Postgres' side the connection arrives on its own loopback.
DATABASE_URL_REMOTE=postgres://memet:PASSWORD@127.0.0.1:15432/db_memet?sslmode=disable
